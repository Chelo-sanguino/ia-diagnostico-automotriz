{
  "openapi": "3.1.0",
  "info": {
    "title": "API de Diagnóstico Automotriz con IA",
    "description": "\nServicio de IA que **clasifica el sistema del vehículo afectado** (ABS, refrigeración, combustible, …)\na partir de los síntomas y de los resultados de dos pasos de diagnóstico.\n\nMetodología: **CRISP-ML(Q)**. Modelo: TF-IDF + Regresión Logística, evaluado con partición\nagrupada por componente (sin fuga de información).\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/predict": {
      "post": {
        "tags": [
          "Predicción"
        ],
        "summary": "Enviar datos al modelo y obtener la clasificación",
        "description": "Recibe los síntomas y los resultados de dos pasos de diagnóstico y devuelve el sistema del vehículo más probable (ABS, Cooling, Fuel, …) con su probabilidad y el top-3. La consulta queda registrada en el historial.",
        "operationId": "predict_api_v1_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predictions": {
      "get": {
        "tags": [
          "Predicción"
        ],
        "summary": "Historial de predicciones previas",
        "description": "Lista paginada (más recientes primero) con los datos enviados y el resultado.",
        "operationId": "list_predictions_api_v1_predictions_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por categoría predicha",
              "title": "Category"
            },
            "description": "Filtrar por categoría predicha"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionHistory"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/metrics": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Métricas de rendimiento del modelo activo",
        "description": "Accuracy, F1 macro y Balanced Accuracy sobre componentes no vistos, métricas por clase, matriz de confusión y estimación de variabilidad (CV agrupada anidada).",
        "operationId": "metrics_api_v1_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/retrain": {
      "post": {
        "tags": [
          "Modelo"
        ],
        "summary": "Solicitar el reentrenamiento del modelo",
        "description": "Entrena una nueva versión con el dataset base + los archivos subidos en `/training-files`. Genera nuevas métricas, guarda la versión y (opcionalmente) la activa. Tarda unos segundos.",
        "operationId": "retrain_api_v1_retrain_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetrainRequest",
                "default": {
                  "include_uploaded": true,
                  "activate": true
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrainResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/training-files": {
      "get": {
        "tags": [
          "Entrenamiento"
        ],
        "summary": "Listar archivos de entrenamiento subidos",
        "operationId": "list_training_files_api_v1_training_files_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TrainingFileOut"
                  },
                  "type": "array",
                  "title": "Response List Training Files Api V1 Training Files Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Entrenamiento"
        ],
        "summary": "Enviar un archivo de entrenamiento",
        "description": "Sube un `.csv` (columnas: category, symptoms, step_1, result_1, step_2, result_2; opcionales: subcategory, component_id) o un `.json` con el formato original del dataset. El archivo se valida y queda disponible para el próximo `/retrain`.",
        "operationId": "upload_training_file_api_v1_training_files_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_training_file_api_v1_training_files_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingFileOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Versiones del modelo (control de cambios)",
        "operationId": "list_models_api_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelVersionOut"
                  },
                  "type": "array",
                  "title": "Response List Models Api V1 Models Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models/{model_id}/activate": {
      "post": {
        "tags": [
          "Modelo"
        ],
        "summary": "Activar una versión anterior del modelo (rollback)",
        "operationId": "activate_model_api_v1_models__model_id__activate_post",
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Model Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelVersionOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/examples": {
      "get": {
        "tags": [
          "Predicción"
        ],
        "summary": "Ejemplos reales del dataset para probar la predicción",
        "operationId": "examples_api_v1_examples_get",
        "parameters": [
          {
            "name": "n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "default": 5,
              "title": "N"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExampleOut"
                  },
                  "title": "Response Examples Api V1 Examples Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Estado del servicio",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
